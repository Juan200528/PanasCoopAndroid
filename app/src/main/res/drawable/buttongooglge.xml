<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Color de fondo verde (puedes ajustar el código) -->
    <solid android:color="#4CAF50"/> <!-- Verde Material 500 -->

    <!-- Bordes redondeados -->
    <corners android:radius="8dp"/> <!-- Más redondeado que el original -->

    <!-- Borde opcional (más oscuro que el fondo) -->
    <stroke
        android:width="1dp"
        android:color="#34A853"/> <!-- Verde Material 700 -->

    <!-- Padding interno -->
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp"/>
</shape>